// =====================================================
// LUDO ROYAL CLUB — Firestore Rules (100% Firebase, koi backend nahi)
// ADMIN EMAIL: neeche apna Gmail dalo + admin.js me ADMIN_EMAILS me wahi dalo.
// Admin Google se login karta hai; likhne ke rights sirf us email ko.
// =====================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // admin.js me ADMIN_EMAILS ke same hona chahiye
    function adminEmail() { return 'ludoroyalclub46@gmail.com'; }
    function isAdmin() {
      return request.auth != null && request.auth.token.email == adminEmail();
    }
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ---------- USERS ----------
    // Read: koi bhi login user (referral list + lobby ke liye naam chahiye).
    // Write: sirf apna wallet counters/naam, baaki sirf admin.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if isOwner(uid);
      // User: sirf ye fields (deposit/withdraw/bets balance yahin se update hota hai).
      // NOTE: backend nahi hai isliye client-side counters; gadbad dikhe to admin console se thik karo.
      allow update: if isAdmin() || (isOwner(uid) && request.resource.data.diff(resource.data)
        .affectedKeys().hasOnly(['name', 'profileLogo', 'photoURL', 'balance', 'totalDeposit', 'totalWithdraw', 'totalWin']));

      match /mails/{mailId} {
        // FIX: welcome/KYC mail app khud banata hai (owner create), warna login fail hota tha
        allow read, update: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) || isAdmin();
      }
    }

    // ---------- BETS (lobby realtime + room-code match flow) ----------
    // Flow: waiting (creator) -> joined (joiner aaya, room code exchange)
    // -> playing (dono confirm) -> completed/cancelled (sirf admin).
    match /bets/{betId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.status == 'waiting';
      allow update: if isAdmin() || (request.auth != null
        && request.resource.data.status in ['joined', 'playing']
        && resource.data.status in ['waiting', 'joined']
        && (request.auth.uid == resource.data.creatorId
         || request.auth.uid == resource.data.joinerId
         || request.auth.uid == request.resource.data.joinerId));
      allow delete: if isAdmin() || (request.auth != null
        && resource.data.creatorId == request.auth.uid
        && resource.data.status == 'waiting');
    }

    // ---------- TRANSACTIONS ----------
    match /transactions/{trxId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      // User: Deposit (Razorpay ke baad Pending — admin approve par paisa)
      // ya Withdraw request (Pending) bana sakta hai
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && ((request.resource.data.type == 'Deposit' && request.resource.data.status in ['Success', 'Pending'])
         || (request.resource.data.type == 'Withdraw' && request.resource.data.status == 'Pending'));
      // Approve / Reject / status change: sirf admin.
      // Owner: apni PENDING deposit cancel kar sakta hai (timer khatam hone par).
      allow update: if isAdmin() || (request.auth != null
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'Pending'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
      allow delete: if isAdmin();
    }

    // ---------- KYC ----------
    match /kyc_requests/{reqId} {
      allow read, create: if request.auth != null;
      // Admin: approve/reject. Owner: sirf apni PENDING request cancel.
      allow update: if isAdmin() || (request.auth != null
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
    }

    // ---------- WIN CLAIMS (jeet ka screenshot proof) ----------
    // User: 1 photo Telegram + yahan request. Admin: approve (prize) / reject.
    // Owner: apni PENDING cancel kar sakta hai (phir dobara bhej sakta hai).
    match /win_claims/{claimId} {
      allow read, create: if request.auth != null;
      allow update: if isAdmin() || (request.auth != null
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
    }

    // ---------- GAMES ----------
    match /games/{gameId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ---------- SETTINGS (app / support / welcome / referral) ----------
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
